# Superset K8s variables
# Copy to .env and edit. Never commit .env.
# Loaded by deploy.sh via: . .env

# K8s namespace
NAMESPACE=demo1

# Domain suffix
DOMAIN=local.lan

# Superset DB password
SUPERSET_PASSWORD=changeme

# Superset secret key
SUPERSET_SECRET_KEY=changeme_superset_secret_key

# Admin credentials
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin

# Superset hostname (full)
SUPERSET_HOST=superset.${NAMESPACE}.${DOMAIN}
